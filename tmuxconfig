set -g history-limit 10000
set -g allow-rename off
set-window-option -g mode-keys vi
set -g set-clipboard on
set -g mouse on
#bind-key -T copy-mode-vi Enter send-keys -X copy-pipe "xclip -selection clipboard -i" ; send-keys -X cancel
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe "xclip -selection clipboard -i" ; send-keys -X cancel

bind c new-window -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

# Abrir janela ALT+A
bind -n M-a new-window -c "#{pane_current_path}"
# Mover entre as janelas ALT+Z e ALT+X
bind -n M-z previous-window
bind -n M-x next-window
# Fechar Janela ALT+C
bind -n M-c confirm-before "kill-window"
# Renomear Janela ALT+R
bind -n M-r command-prompt -p "rename-window:" "rename-window '%%'"
# Mostrar Sessoes ALT+G
bind -n M-g choose-tree -Z
# Criar novo grupo
bind -n M-n run-shell "tmux new-session -d -c '#{pane_current_path}' && tmux choose-tree -Z"
# deletar grupo
bind -n M-m confirm-before -p "kill-session? (y/n)" "kill-session"

# Remove BSpace no copy-mode-vi
unbind-key -T copy-mode-vi BSpace

# Também nos outros modes por segurança
unbind-key -T copy-mode BSpace
unbind -n BSpace

# ==============================================================================
# DISPLAY & TERMINAL
# ==============================================================================
set -g default-terminal 'tmux-256color'
set -as terminal-overrides ',xterm*:Tc:sitm=\E[3m' # italics
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'  # undercurl
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m' # underscore colours

# Styling
set -g message-style 'fg=colour176 bold'
setw -g mode-style 'fg=colour8 bg=colour7'
set -g pane-border-style 'fg=colour0'
set -g pane-active-border-style 'fg=colour4'

# ==============================================================================
# STATUS BAR
# ==============================================================================
set -g status-position top
set -g status-justify left
set -g status-style 'fg=colour176'
set -g status-left ' ·'
set -g status-left-length 10
set -g status-right-length 80

# Status Right: Built using append (-a) for readability
set -g  status-right '#{?client_prefix,#[fg=colour6 italics]mod,#[fg=colour8]···}'
set -ag status-right '#[default] #{?#{==:#I,0},#[fg=colour176],#[fg=colour8]}[notes] '
set -ag status-right '#{?window_zoomed_flag,#[fg=colour6][+],#[fg=colour8][#{window_panes}]} '
set -ag status-right '#[fg=colour8][#[fg=colour176]#S #[fg=colour8]at #[fg=colour176]#{client_user} #[fg=colour8]on #[fg=colour176]#h#[fg=colour8]] · '

# Window Status (Index 0 hidden)
setw -g window-status-separator ""
setw -g window-status-style 'fg=colour176'
setw -g window-status-current-style 'fg=colour176'
setw -g window-status-bell-style 'fg=colour2 bg=colour176 bold'
# Conditional formatting: if index is 0, print nothing; otherwise print index+name with leading space
setw -g window-status-format '#{?#{==:#I,0},, #[fg=colour8]#I #[fg=colour8]#W }'
setw -g window-status-current-format '#{?#{==:#I,0},, #I #W }'
